{
  "version": 2,
  "env": {
    "SUPABASE_URL": "YOUR_SUPABASE_PROJECT_URL",
    "SUPABASE_KEY": "YOUR_SUPABASE_ANON_KEY",
    "ADMIN_PASSWORD": "6028",
    "JWT_SECRET": "admin_jwt_secret_2026",
    "SESSION_SECRET": "brewedbook_cafe_qr_session_secret_2026"
  },
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "/api/$1.js",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "^/(?!api).*",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x",
      "memory": 512,
      "maxDuration": 10
    }
  }
}
